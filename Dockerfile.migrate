FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder

ARG TARGETARCH
ARG TARGETOS=linux

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-s -w" -o /migrate ./cmd/migrate

FROM alpine:3.24

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /migrate /usr/local/bin/migrate

ENTRYPOINT ["migrate"]
