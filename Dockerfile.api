FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder

ARG TARGETARCH
ARG TARGETOS=linux

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-s -w" -o /api ./cmd/api

FROM alpine:3.24

# The alpine:3.24 tag can lag behind the point release: upgrade so every
# release ships the current security fixes (openssl, musl, zlib, …).
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 asstats && adduser -S -D -H -u 10001 -G asstats asstats

COPY --from=builder /api /usr/local/bin/api

# Unprivileged: the API listens on 8080 and writes no files.
USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["api"]
