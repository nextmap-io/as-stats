FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder

ARG TARGETARCH
ARG TARGETOS=linux

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-s -w" -o /collector ./cmd/collector

FROM alpine:3.24

# The alpine:3.24 tag can lag behind the point release: upgrade so every
# release ships the current security fixes (openssl, musl, zlib, …).
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata

COPY --from=builder /collector /usr/local/bin/collector

EXPOSE 2055/udp 6343/udp

ENTRYPOINT ["collector"]
