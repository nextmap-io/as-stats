# ── ClickHouse ──────────────────────────────────
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=asstats
CLICKHOUSE_USER=asstats
CLICKHOUSE_PASSWORD=changeme-use-a-strong-password

# The one-shot migrator safely adopts a recognized legacy schema on its first
# run. Set false if every legacy-volume baseline requires manual review.
MIGRATE_AUTO_BASELINE=true
# Overall deadline for schema inspection and all pending ClickHouse DDL.
MIGRATE_TIMEOUT=30m

# ── Collector ──────────────────────────────────
COLLECTOR_LISTEN_NETFLOW=:2055
COLLECTOR_LISTEN_SFLOW=:6343
# Flushing is time-driven on purpose. Every INSERT into flows_raw fans out to
# ~20 materialised views and creates ~21 parts, so part count and the merge I/O
# that follows scale with the number of INSERTs, not with rows (30s vs 5s
# measured -83% parts, -74% merge I/O). The interval sets the cadence; the
# batch size is only a burst ceiling — keep it above interval x peak flows/s.
# Worst-case memory held in the pipeline is ~4 x batch size x ~310 B.
COLLECTOR_BATCH_SIZE=50000
COLLECTOR_FLUSH_INTERVAL=15s
COLLECTOR_WORKERS=4
# Upper bound on the SIGTERM drain (decoders, enricher, final flush). Keep it
# below the container stop grace period (compose sets 60s).
COLLECTOR_SHUTDOWN_TIMEOUT=40s
# Upper bound on one batch INSERT. A batch that fails or times out is dropped
# and counted in asstats_flows_dropped_total — never retried, because a
# partially committed INSERT would double count in the materialised views.
COLLECTOR_FLUSH_TIMEOUT=30s

# Your public AS number (optional but recommended).
# When set, the collector fetches your announced prefixes from RIPEstat
# and remaps private AS numbers (64512-65534) to your public AS on matching flows.
LOCAL_AS=

# ── API Server ─────────────────────────────────
API_LISTEN_ADDR=:8080
API_CORS_ORIGINS=https://as-stats.example.com

# ── Authentication (OIDC) ──────────────────────
AUTH_ENABLED=true
# Explicit security opt-out for trusted local/test deployments only.
# Required when AUTH_ENABLED=false; never enable this accidentally in production.
ALLOW_UNAUTHENTICATED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://as-stats.example.com/auth/callback
OIDC_SCOPES=openid profile email

# ── Optional features ──────────────────────────
# Detailed flow log: keeps full per-tuple flow records (src/dst IP+port,
# protocol, TCP flags) in the flows_log table for forensic search.
# Default retention: 180 days. Estimate +250 GB / 6mo at 1:1000 sampling
# on a 1 Gbps link. Enables /flows/search API and Flow Search UI page.
FEATURE_FLOW_SEARCH=false

# Initial flows_log retention in days. This SEEDS the flows_log row in
# retention_policies on the very first collector startup; afterwards that table
# is the source of truth and this variable is ignored (the collector logs a line
# saying so if the two disagree). To change retention on a running deployment,
# use the admin UI / PUT /admin/retention/flows_log.
FLOW_LOG_RETENTION_DAYS=180

# Port and protocol statistics: aggregates flows by (proto, port) into
# the traffic_by_port table for "Top Ports" and "Top Protocols" views.
# Lightweight (~5 MB/day). Enables /top/protocol and /top/port endpoints.
FEATURE_PORT_STATS=false

# DDoS detection / alert engine: runs a goroutine in the collector that
# evaluates configurable rules against pre-aggregated hot tables every
# ALERT_EVAL_INTERVAL. Default rules are seeded on first startup.
# Enables the /alerts dashboard, alert badge in the header, and admin
# rule/webhook management.
FEATURE_ALERTS=false

# Alert engine tuning (only used when FEATURE_ALERTS=true).
ALERT_EVAL_INTERVAL=30s
ALERT_STALE_THRESHOLD=5m

# ── Prometheus metrics ──────────────────────────
# Metrics are exposed on /metrics (API server) and on a separate HTTP
# listener for the collector (default :9090). Both share the same auth
# config below.

# Collector: address for the standalone /metrics HTTP server.
# Set to empty string to disable.
COLLECTOR_PROMETHEUS_ADDR=:9090

# Restrict /metrics access to specific IPs or CIDRs (comma-separated).
# Empty = open (common in private networks behind a firewall).
# Example: PROMETHEUS_ALLOW_CIDR=10.0.0.5/32,192.168.1.0/24
PROMETHEUS_ALLOW_CIDR=

# Optional basic auth for /metrics. Both must be set to enable.
# Useful when /metrics is reachable from the internet.
PROMETHEUS_USER=
PROMETHEUS_PASS=
